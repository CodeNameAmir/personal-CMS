# AI Studio runtime defaults
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase (public client configuration for GitHub Pages / Vite static build)
# Configure these in GitHub Repository Secrets (VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY)
# or in your local .env file for development. Never put SUPABASE_SECRET_KEY in VITE_* vars.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Optional server-side aliases for AI Studio Secrets panel (exposed to client via /api/config in preview)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

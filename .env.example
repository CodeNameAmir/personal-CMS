# AI Studio runtime defaults
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase (public client configuration for static hosting / Vite build)
# Configure these in GitHub Repository Secrets (VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY)
# or in your local .env file for development. Never put SUPABASE_SECRET_KEY in VITE_* vars.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-side Supabase config for Express BFF mode (server.ts)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Optional server-only secret key for scheduled background session cleanup (never expose to client)
SUPABASE_SECRET_KEY=""

# Express BFF proxy, CORS, and cookie configuration
# Comma-separated list of allowed browser origins (leave blank for same-origin only)
ALLOWED_ORIGINS=""
# Reverse proxy trust: defaults to "false" (never trusts spoofable X-Forwarded-* headers by default).
# Set to "loopback", "uniquelocal", a hop count (1..10), or a comma-separated IP/CIDR allowlist
# (e.g. "127.0.0.1,10.0.0.0/8") when deployed behind a trusted reverse proxy or CDN.
TRUST_PROXY="false"
# Optional cookie SameSite override in HTTPS production: none (default for iframe compatibility), lax, or strict
COOKIE_SAME_SITE=""

# Public signup & endpoint rate limits (Express BFF)
# Public user registration remains enabled; these bounds mitigate automated signup floods.
SIGNUP_RATE_LIMIT_IP_MAX="10"
SIGNUP_RATE_LIMIT_IP_WINDOW_SEC="900"
SIGNUP_RATE_LIMIT_USER_MAX="5"
SIGNUP_RATE_LIMIT_USER_WINDOW_SEC="900"
SIGNUP_RATE_LIMIT_GLOBAL_MAX="60"
SIGNUP_RATE_LIMIT_GLOBAL_WINDOW_SEC="3600"
LOGIN_RATE_LIMIT_IP_MAX="20"
LOGIN_RATE_LIMIT_USER_MAX="12"
WEBHOOK_RATE_LIMIT_IP_MAX="120"

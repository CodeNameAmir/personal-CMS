# AI Studio runtime defaults
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase (public client configuration for GitHub Pages / Vite static build)
# Configure these in GitHub Repository Secrets (VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY)
# or in your local .env file for development. Never put SUPABASE_SECRET_KEY in VITE_* vars.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-side Supabase config for BFF mode (Express server.ts)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Optional server-only secret key for scheduled background session cleanup (never expose to client)
SUPABASE_SECRET_KEY=""

# Express BFF security configuration
# Comma-separated list of allowed CORS origins (leave blank for same-origin only)
ALLOWED_ORIGINS=""
# Number of reverse proxy hops to trust (e.g. 1 behind Cloud Run / CDN, or false if direct)
TRUST_PROXY="1"
# Optional cookie SameSite override in HTTPS production: none (default for iframe compatibility), lax, or strict
COOKIE_SAME_SITE=""
